{
  "name": "department-store",
  "private": true,
  "version": "0.1.0",
  "description": "Departmental store ERP: Windows POS (Tauri+React), owner dashboard (Next.js), shared API contracts",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck",
    "scan:secrets": "python scripts/ci/secret_scan.py",
    "validate:configs": "python scripts/ci/validate_deployment_configs.py",
    "test:pos": "npm run test --workspace @departmental/windows-pos",
    "test:dashboard": "npm run test --workspace @departmental/owner-dashboard",
    "test:mobile": "npm run test --workspace @departmental/mobile",
    "dev:pos": "npm run dev --workspace @departmental/windows-pos",
    "dev:dashboard": "npm run dev --workspace @departmental/owner-dashboard",
    "dev:mobile": "npm run start --workspace @departmental/mobile"
  },
  "engines": {
    "node": ">=20"
  }
}
