{
  "$schema": "https://schema.tauri.app/capabilities/2",
  "identifier": "default",
  "description": "POS window capabilities: SQL plugin (catalog cache + durable outbox) and raw printing",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "sql:allow-close",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*:*/*"
        },
        {
          "url": "https://*:*/*"
        },
        {
          "url": "http://localhost:**"
        },
        {
          "url": "http://localhost:8080/*"
        }
      ]
    }
  ]
}