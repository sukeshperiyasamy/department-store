# Owner Dashboard Environment Configuration Template (.env.example)
# ERPNext base URL reachable from the dashboard server
ERP_BASE_URL=http://localhost:8080

# Scoped API credentials for server-to-server operations
DASHBOARD_API_KEY=placeholder_api_key
DASHBOARD_API_SECRET=placeholder_api_secret

# Optional token for protected health & telemetry route
HEALTH_CHECK_TOKEN=placeholder_health_token

# Platform base domain
BASE_DOMAIN=departmentstore.in
TRUSTED_PROXY_IPS=127.0.0.1,::1
